import {
  "moonbit-community/rabbita/internal/vdom",
  "moonbit-community/rabbita/dom",
  "moonbit-community/rabbita/common",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/sub",
  "moonbitlang/core/queue",
  "moonbitlang/core/json",
  "moonbit-community/rabbita/js",
  "moonbitlang/async",
  "moonbit-community/rabbita/internal/key",
  "moonbit-community/rabbita/internal/any",
  "moonbit-community/rabbita/internal/slotmap",
  "moonbit-community/rabbita/internal/duplix",
}

warnings = "-unused_package"

supported_targets = "js+native+wasm"

options(
  targets: {
    "host_browser.mbt": [ "js" ],
    "host_hydration.mbt": [ "js" ],
    "host_ssr.mbt": [ "wasm", "native" ],
  },
)
