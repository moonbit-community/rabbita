import {
  "moonbit-community/rui/internal/checkbox_view",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/clipboard",
  "moonbit-community/rabbita/svg",
  "moonbit-community/cmark/cmark",
}

import {
  "moonbit-community/rabbita",
  "moonbitlang/async",
} for "test"

// SSR tests use these imports only on native/wasm.

warnings = "-unused_package"

supported_targets = "js+native+wasm"

options(
  "pre-build": [
    {
      "input": "__fixtures__/async-0.22.2-README.md",
      "output": "async_readme_test.mbt",
      "command": ":embed -i $input -o $output --name async_readme --text",
    },
    {
      "input": "__fixtures__/ripgrep-README.md",
      "output": "ripgrep_test.mbt",
      "command": ":embed -i $input -o $output --name ripgrep_readme --text",
    },
  ],
)
